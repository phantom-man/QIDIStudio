{
    "hosting": [
        {
            "target": "nexusslicer",
            "public": "nexusslicer",
            "ignore": [
                "firebase.json",
                "**/.*"
            ],
            "headers": [
                {
                    "source": "**/*.@(js|css|svg|png|ico|woff2)",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "public, max-age=31536000, immutable"
                        }
                    ]
                },
                {
                    "source": "**/*.html",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "public, max-age=300, must-revalidate"
                        }
                    ]
                }
            ],
            "rewrites": [
                {
                    "source": "**",
                    "destination": "/index.html"
                }
            ]
        },
