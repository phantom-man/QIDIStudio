# QIDIStudio Agent Fleet — Environment Variables
# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit secrets.

# ── LangSmith ────────────────────────────────────────────────────────────────
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
# NOTE: LANGCHAIN_PROJECT is intentionally NOT set here.
#   Each agent/pipeline sets its own project dynamically.
#   Uncomment ONLY if you want a global fallback.
# LANGCHAIN_PROJECT=qidistudio-agents
LANGCHAIN_TRACING_V2=true

# ── Google AI (Gemini) ────────────────────────────────────────────────────────
# Get key at: https://ai.google.dev/gemini-api/docs/api-key
GOOGLE_API_KEY=your_google_api_key_here

# Optional: force Vertex AI backend instead of Gemini Developer API
# GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_CLOUD_PROJECT=crafty-hook-483415-b3
# GOOGLE_CLOUD_LOCATION=us-central1

# ── Tavily Search (used by research pipelines) ────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Cloud SQL (PostgreSQL) ────────────────────────────────────────────────────
# Format: project:region:instance-name
CLOUD_SQL_INSTANCE_CONNECTION_NAME=crafty-hook-483415-b3:us-central1:qidistudio-db
CLOUD_SQL_DB_USER=qidistudio_app
CLOUD_SQL_DB_PASS=your_cloud_sql_password_here
CLOUD_SQL_DB_NAME=qidistudio
# Local dev override (skips Cloud SQL Connector — connect direct via DSN)
# CLOUD_SQL_DSN=postgresql+asyncpg://user:pass@localhost:5432/qidistudio

# ── BigQuery ──────────────────────────────────────────────────────────────────
BIGQUERY_PROJECT_ID=crafty-hook-483415-b3
BIGQUERY_DATASET_ID=qidistudio_research
# Path to a GCP service account key JSON file (if not using ADC / Workload Identity)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# ── Auth / JWT (RS256) ────────────────────────────────────────────────────────
# Path to RSA private key (server-side only — never expose to clients)
JWT_PRIVATE_KEY_PATH=keys/private.pem
# Path to RSA public key (safe to distribute)
JWT_PUBLIC_KEY_PATH=keys/public.pem
# Auth service base URL (set to your deployed Cloud Run / GKE endpoint)
QIDISTUDIO_AUTH_URL=https://auth.qidistudio.com
# Grace period in hours before a cached pro token triggers a network refresh
AUTH_GRACE_PERIOD_HOURS=72

# ── Slicer Bridge / Preset Fetcher ────────────────────────────────────────────
# Max age before preset cache is considered stale and re-fetched
PRESET_CACHE_MAX_AGE_HOURS=6

# ── Research Evaluator ────────────────────────────────────────────────────────
# Set to true to auto-write evaluation reports to BigQuery
WRITE_EVAL_TO_BQ=false

# ── Firebase / Firestore (legacy — filament_pipeline.py) ──────────────────────
# GOOGLE_APPLICATION_CREDENTIALS also covers Firestore if service account has access
# FIRESTORE_PROJECT=crafty-hook-483415-b3

# ── GCS / Cloud Storage (legacy — filament_pipeline.py snapshots) ─────────────
# GCS_BUCKET_NAME=qidistudio-filament-research
